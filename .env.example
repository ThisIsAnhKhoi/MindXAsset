# ==========================================
# MINDXASSET - TỔNG HỢP CẤU HÌNH MÔI TRƯỜNG
# ==========================================

# 1. Cấu hình Backend (sao chép vào backend/.env)
PORT=5000

# Khóa API Pollinations (Tùy chọn - để trống nếu dùng chế độ Free/Anonymous)
# Lấy khóa cá nhân tại: https://pollinations.ai
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Cấu hình lưu trữ đám mây Cloudinary (Tùy chọn - nếu không có sẽ fallback lưu ổ đĩa cục bộ)
# Lấy thông số tại: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cờ tắt thư viện tách nền rembg (Bật "true" khi chạy trên môi trường RAM thấp <1GB như Render Free)
DISABLE_REMBG=false

# URL Backend khi deploy Render (Tùy chọn)
RENDER_EXTERNAL_URL=

# 2. Cấu hình Frontend (sao chép vào frontend/.env)
# Để trống hoặc http://localhost:5000 khi chạy local
VITE_API_BASE_URL=http://localhost:5000
